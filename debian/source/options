# Build artifacts / bootstrap scratch created during the build; never let
# dpkg-source mistake them for source content if the tree is dirty.
extend-diff-ignore = "(^|/)debian/\.bootstrap(/|$)"
tar-ignore = "debian/.bootstrap"
tar-ignore = "out"
extend-diff-ignore = "(^|/)out(/|$)"
extend-diff-ignore = "(^|/)debian/fakehome(/|$)"
tar-ignore = "debian/fakehome"
extend-diff-ignore = "(^|/)debian/tmp(/|$)"
tar-ignore = "debian/tmp"
extend-diff-ignore = "(^|/)debian/(node26|libnode147|libnode26-dev|node26-doc)(/|$)"
tar-ignore = "debian/node26"
tar-ignore = "debian/libnode147"
tar-ignore = "debian/libnode26-dev"
tar-ignore = "debian/node26-doc"
extend-diff-ignore = "(^|/)(config\.gypi|config\.mk|config\.status)$"
tar-ignore = "config.gypi"
tar-ignore = "config.mk"
tar-ignore = "config.status"
extend-diff-ignore = "(^|/)(node|node_g)$"
tar-ignore = "node"
tar-ignore = "node_g"
extend-diff-ignore = "(^|/)test/(tmp|\.tmp)"
tar-ignore = "test/tmp*"
tar-ignore = "test/.tmp*"
